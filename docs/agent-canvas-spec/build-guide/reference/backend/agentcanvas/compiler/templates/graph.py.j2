# Do not edit by hand: change the canvas and re-generate.
{#- Template rule: optional config keys MUST use n.config.get(key, default) (StrictUndefined). #}
from __future__ import annotations

from langgraph.graph import END, START, StateGraph

from agentcanvas.runtime import nodes as ac

STATE_CHANNELS = {{ channels | pprint }}
State = ac.make_state_type("State", STATE_CHANNELS)


def build_graph(resources: ac.Resources | None = None, checkpointer=None, store=None):
    resources = resources or ac.Resources()
    builder = StateGraph(State)
{% for r in wf.resources %}
    # ── @canvas-resource {{ r.id }} "{{ r.name }}" ({{ r.type }}) ──
{%- if r.type == "model.chat" %}
    {{ r.name }} = resources.model({{ r.name | py }}, {{ r.config | pprint }})
{%- else %}
    {{ r.name }} = resources.tool({{ r.name | py }}, {{ r.config | pprint }})
{%- endif %}
{% endfor %}
{%- for n in wf.nodes %}
    # ── @canvas-node {{ n.id }} "{{ n.label or n.name }}" ({{ n.type }}) ──
{%- if n.type == "core.llm" %}
    builder.add_node({{ n.name | py }}, ac.llm_node(model={{ model_of[n.id] }}, prompt={{ n.config.prompt | py }}, output={{ n.config.output | py }}), metadata={"canvas_node_id": {{ n.id | py }}})
{%- elif n.type == "core.agent" %}
    builder.add_node({{ n.name | py }}, ac.agent_node(name={{ n.name | py }}, model={{ model_of[n.id] }}, tools=[{{ tools_of[n.id] | join(", ") }}], system_prompt={{ n.config.get("system_prompt", "") | py }}, approve_tools={{ n.config.get("approve_tools") | py }}), metadata={"canvas_node_id": {{ n.id | py }}})
{%- elif n.type == "core.router" %}
    {{ n.name }}_route = ac.router_fn(cases={{ n.config.get("cases", []) | pprint }}, default={{ n.config.get("default", "default") | py }})
    builder.add_node({{ n.name | py }}, ac.passthrough, metadata={"canvas_node_id": {{ n.id | py }}})
{%- elif n.type == "core.approval" %}
    builder.add_node({{ n.name | py }}, ac.approval_node(node_id={{ n.id | py }}, show={{ n.config.show | py }}, output={{ n.config.output | py }}), metadata={"canvas_node_id": {{ n.id | py }}})
{%- elif n.type == "core.set" %}
    builder.add_node({{ n.name | py }}, ac.set_node(values={{ n.config["values"] | pprint }}), metadata={"canvas_node_id": {{ n.id | py }}})
{%- elif n.type == "core.script" %}
    builder.add_node({{ n.name | py }}, ac.script_node(import_path={{ n.config.import_path | py }}), metadata={"canvas_node_id": {{ n.id | py }}})
{%- endif %}
{% endfor %}
    # ── flow edges ──
{%- for src, dst in plain_edges %}
    builder.add_edge({{ src }}, {{ dst }})
{%- endfor %}
{%- for rname, mapping in router_edges %}
    builder.add_conditional_edges({{ rname | py }}, {{ rname }}_route, {{ mapping }})
{%- endfor %}

    return builder.compile(checkpointer=checkpointer, store=store, name={{ wf.id | py }})
